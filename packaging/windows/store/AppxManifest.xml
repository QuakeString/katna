<!--
  Katna Mail's Microsoft Store package (MSIX), built by
  ci/windows-store-package.ps1; packaging/windows/store/README.md says how.

  PLACEHOLDER: the three identity values below come from Partner Center
  (Apps and games > Katna Mail > Product identity) and must match it
  exactly, or the Store refuses the upload:
    Identity Name         = "Package/Identity/Name"
    Identity Publisher    = "Package/Identity/Publisher"
    PublisherDisplayName  = "Package/Properties/PublisherDisplayName"
  @VERSION@ is filled in by the build.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="PLACEHOLDER.KatnaMail"
    Publisher="CN=PLACEHOLDER-PUBLISHER-ID"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Katna Mail</DisplayName>
    <PublisherDisplayName>PLACEHOLDER Publisher display name</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 10 1903, as Katna Setup. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="KatnaMail" Executable="katna-mail.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Katna Mail"
        Description="Read, search and write email from all your accounts in one place"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Katna Mail opens mailto: links (Windows Settings > Default apps). -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="mailto">
            <uap:DisplayName>Katna Mail</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- Start at sign-in (katna_platform::store), off until Katna Mail
             turns it on; Settings > Apps > Startup shows it. -->
        <desktop:Extension Category="windows.startupTask" Executable="katna-mail.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="KatnaStartup" Enabled="false" DisplayName="Katna Mail" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
