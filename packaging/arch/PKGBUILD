# SPDX-License-Identifier: GPL-3.0-or-later
# Arch Linux package for Katna, built from this git checkout.
#
#   cd packaging/arch && makepkg -si
#
# makepkg clones the checkout it sits in (committed HEAD only; uncommitted
# changes are not packaged). See packaging/README.md.

pkgname=katna-git
pkgver=0.0.0.r0.g0000000
pkgrel=1
pkgdesc='Katna Mail and the Katna background sync service'
arch=('x86_64' 'aarch64')
url='https://github.com/QuakeString/katna'
license=('GPL-3.0-or-later')
# Linked: libxcb, libxkbcommon(-x11), glibc, gcc-libs; fontconfig and
# freetype2 when found at build time. Loaded at runtime: libwayland-client,
# libvulkan (vulkan-icd-loader) and libEGL (libglvnd, the OpenGL fallback).
# dbus: the session bus that katna-daemon and the apps talk over.
# polkit: pkexec and the password prompt for updates from Katna Mail.
# minisign: the update helper checks an update's signature with it.
# zstd (pacman needs it too): the helper compresses the package it keeps.
depends=(
  'dbus'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glibc'
  'libglvnd'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'minisign'
  'polkit'
  'vulkan-icd-loader'
  'wayland'
  'zstd'
)
makedepends=('cargo' 'gettext' 'git')
optdepends=(
  'gnupg: read and send encrypted and signed mail (OpenPGP and S/MIME)'
  'org.freedesktop.secrets: keeps account passwords (GNOME Keyring, KWallet or KeePassXC)'
  'vulkan-driver: GPU rendering with Vulkan instead of the OpenGL fallback'
  'hunspell-en_us: spell check while writing mail (or another hunspell dictionary)'
  'noto-fonts: letters of Indic, Thai, Khmer, Lao, Burmese, Tibetan, Ethiopic, Arabic and Hebrew mail and translations'
  'noto-fonts-cjk: Chinese, Japanese and Korean mail and translations'
  'noto-fonts-emoji: colour emoji in mail and in the app'
  'python-nautilus: Send with Katna Mail in the right-click menu of GNOME Files'
)
provides=('katna')
conflicts=('katna')
# makepkg's LTO flags make the C code that crates build (SQLite, ring,
# zstd) into GCC LTO objects, which rustc's link step does not handle.
# Rust code still gets LTO from Cargo's release profile, which also strips
# the binaries, so a -debug package would be empty.
options=('!lto' '!debug')
# Removes the copy of the installed package the update helper keeps.
install=katna-git.install
# The repository root, two levels above this file. `git -C` also works
# from a linked worktree.
source=("katna::git+file://$(git -C "${startdir:-.}" rev-parse --show-toplevel 2>/dev/null || realpath ../..)")
sha256sums=('SKIP')

# Binaries that go into the package. katna-calendar is not ready yet.
_bins=(katna-mail katna-daemon katnactl)

pkgver() {
  cd katna
  # From the version tags (docs/RELEASING.md); the arch-latest release tag
  # is not a version.
  sh packaging/linux/version.sh
}

prepare() {
  cd katna
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd katna
  export RUSTUP_TOOLCHAIN=stable
  # CI builds in a cached directory outside the clone.
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  # Katna Mail names this version in What's new after an update.
  export KATNA_VERSION="$pkgver"
  # When its commit was made (Unix seconds), for the Update dialog.
  KATNA_BUILT="$(git log -1 --format=%ct)"
  export KATNA_BUILT
  # Its first line, the build's newest change.
  KATNA_TITLE="$(git log -1 --format=%s)"
  export KATNA_TITLE
  # Katna updates itself from the arch-latest release, with pacman
  # (katna_core::update::Package).
  export KATNA_PACKAGE=arch
  # Two builds: in one, Cargo would give katna-daemon and katnactl the
  # features GPUI turns on in shared crates, making them bigger for nothing.
  cargo build --frozen --release --package katna-mail
  cargo build --frozen --release --package katna-daemon --package katnactl
}

package() {
  cd katna
  local bin
  for bin in "${_bins[@]}"; do
    install -Dm755 "${CARGO_TARGET_DIR:-target}/release/$bin" "$pkgdir/usr/bin/$bin"
  done

  # The file names are the IDs from katna_core::ids; globs keep them out
  # of this file (crates/katna-core/tests/packaging.rs checks them).
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" packaging/systemd/*.service
  install -Dm644 -t "$pkgdir/usr/share/dbus-1/services" packaging/dbus/*.service
  # .desktop files get their names in every language on the way.
  local file dir
  for file in packaging/desktop/*.desktop packaging/krunner/*.desktop packaging/kio/*.desktop; do
    case $file in
      packaging/desktop/*) dir=applications ;;
      packaging/krunner/*) dir=krunner/dbusplugins ;;
      packaging/kio/*) dir=kio/servicemenus ;;
    esac
    install -dm755 "$pkgdir/usr/share/$dir"
    sh packaging/linux/localize-desktop.sh "$file" "$pkgdir/usr/share/$dir/${file##*/}"
    chmod 644 "$pkgdir/usr/share/$dir/${file##*/}"
  done
  install -Dm644 -t "$pkgdir/usr/share/gnome-shell/search-providers" packaging/gnome-shell/*.ini
  # "Send with Katna Mail" on files and folders in Dolphin (above) and GNOME Files.
  install -Dm644 -t "$pkgdir/usr/share/nautilus-python/extensions" packaging/nautilus/*.py
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps" packaging/icons/*.svg
  for dir in packaging/icons/hicolor/*/apps; do
    install -Dm644 -t "$pkgdir/usr/share/icons/${dir#packaging/icons/}" "$dir"/*
  done
  # Updates from Katna Mail: the helper pkexec runs, and the polkit
  # action that allows it (katna_core::update::ARCH_HELPER).
  install -Dm755 packaging/arch/katna-update-helper "$pkgdir/usr/lib/katna/katna-update-helper"
  install -Dm644 -t "$pkgdir/usr/share/polkit-1/actions" packaging/polkit/*.policy
  # With it, the helper installs only updates signed by its private half.
  if [[ -f packaging/keys/katna-update.pub ]]; then
    install -Dm644 packaging/keys/katna-update.pub "$pkgdir/usr/lib/katna/update-key.pub"
  fi
  # The desktop clock (integrations/README.md): Katna Digital Clock for
  # Plasma and Katna's GNOME Shell extension. Each desktop ignores the
  # other's files. The widget's folder is named by its plugin ID.
  local clock file
  clock=$(sed -n 's/^ *"Id": "\(.*\)",\{0,1\}$/\1/p' integrations/plasma-clock/package/metadata.json)
  (cd integrations/plasma-clock/package && find . -type f) | while read -r file; do
    install -Dm644 "integrations/plasma-clock/package/$file" \
      "$pkgdir/usr/share/plasma/plasmoids/$clock/${file#./}"
  done
  (cd integrations/gnome-shell-extension && find . -type f) | while read -r file; do
    install -Dm644 "integrations/gnome-shell-extension/$file" \
      "$pkgdir/usr/share/gnome-shell/extensions/${file#./}"
  done
  for file in integrations/po/*.po; do
    [[ -e $file ]] || continue
    install -d "$pkgdir/usr/share/locale/$(basename "$file" .po)/LC_MESSAGES"
    msgfmt -o "$pkgdir/usr/share/locale/$(basename "$file" .po)/LC_MESSAGES/katna-clock.mo" "$file"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
