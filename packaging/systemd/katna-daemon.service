# systemd user unit for katna-daemon (docs/ARCHITECTURE.md §9.2).
# Same as `katna-daemon install-user-service` writes (apps/katna-daemon/src/install.rs);
# tests there and in crates/katna-core/tests/packaging.rs check it.
[Unit]
Description=Katna mail and calendar service

[Service]
Type=dbus
BusName=in.invenia.katna.Daemon
ExecStart=/usr/bin/katna-daemon
Restart=on-failure
# Five seconds apart, so a crash loop never reaches systemd's start limit
# (5 in 10 s) and the service is always tried again.
RestartSec=5

[Install]
WantedBy=default.target
