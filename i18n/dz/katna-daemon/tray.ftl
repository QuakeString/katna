## The tray icon's menu

tray-open-inbox = _ནང་འབྱོར་སྒྲོམ་ཁ་ཕྱེ།
tray-new-message = _འཕྲིན་དོན་གསརཔ
tray-new-task = _ལཱ་གསརཔ
tray-new-note = དྲན་ཐོ་གསརཔ (_O)
tray-preferences = _སྒྲིག་སྟངས
tray-quit = སྤ_ང་།

## The tray icon's tooltip

tray-unread = { $count ->
    [0] མ་ལྷག་པའི་འཕྲིན་དོན་མེད།
   *[other] མ་ལྷག་པའི་འཕྲིན་དོན་ { $count }
}
tray-password-refused = { $address } གི་དོན་ལུ་ ཆོག་ཡིག་གསརཔ་དགོ
tray-signed-out = { $address } ལུ་ ལོག་ནང་བསྐྱོད་འབད།
tray-accounts-need-you = རྩིས་ཐོ་ { $count } ལུ་ ཁྱོད་དགོ
tray-not-sent = { $count ->
   *[other] འཕྲིན་དོན་ { $count } མ་བཏང་།
}
