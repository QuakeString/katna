## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = བརྡ་བསྐུལ་ཚུ་སྒྲ་མེད་བཟོ།
quiet-tip-off = སྒྲ་མེད་ཨིན། ལོག་བརྡ་བསྐུལ་འབད་ནིའི་དོན་ལུ་ཨེབ།
quiet-tip-muted-until = { $when } ཚུན་ སྒྲ་མེད་ཨིན། ལོག་བརྡ་བསྐུལ་འབད་ནིའི་དོན་ལུ་ཨེབ།

## The right-click menu of a folder or an account

quiet-mute = སྒྲ་མེད་བཟོ…
quiet-unmute = སྒྲ་ལོག་བཏོན།
quiet-notify = གློག་འཕྲིན་གསརཔ་གི་དོན་ལུ་ བརྡ་བསྐུལ་འབད།

## How long to mute

quiet-for-hour = ཆུ་ཚོད་ 1 གི་དོན་ལུ
quiet-until-tomorrow = ནངས་པ་ཞོགས་པ་ཚུན
quiet-until-unmuted = ང་གིས་ ལོག་ཨོན་མ་འབད་ཚུན
quiet-turn-on = གློག་འཕྲིན་གསརཔ་གི་དོན་ལུ་ བརྡ་བསྐུལ་འབད།

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } སྒྲ་མེད་བཟོ་ཡི
quiet-muted-until = { $name } { $when } ཚུན་ སྒྲ་མེད་བཟོ་ཡི
quiet-on = { $name } གིས་ ལོག་བརྡ་བསྐུལ་འབདཝ་ཨིན

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = གླེང་མོལ་སྒྲ་མེད་བཟོ།
quiet-unmute-conversation = གླེང་མོལ་གྱི་སྒྲ་ལོག་བཏོན།
quiet-mute-sender = གཏང་མི་སྒྲ་མེད་བཟོ།
quiet-unmute-sender = གཏང་མི་གི་སྒྲ་ལོག་བཏོན།
quiet-row-muted = སྒྲ་མེད
quiet-conversation-strip = སྒྲ་མེད་ཨིན། ལན་གསརཔ་ཚུ་གིས་ བརྡ་བསྐུལ་ཡང་མི་འབད་ གྱངས་ཁ་ནང་ཡང་མི་རྩིས།
quiet-conversation-muted = { $count ->
   *[other] གླེང་མོལ་ { $count } སྒྲ་མེད་བཟོ་ཡི
}
quiet-conversation-unmuted = { $count ->
   *[other] གླེང་མོལ་ { $count } གི་སྒྲ་ལོག་བཏོན་ཡི
}
quiet-sender-strip = སྒྲ་མེད་ཨིན། ཁོང་གི་གློག་འཕྲིན་གྱིས་ བརྡ་བསྐུལ་ཡང་མི་འབད་ གྱངས་ཁ་ནང་ཡང་མི་རྩིས།
quiet-sender-muted = { $address } ལས་གློག་འཕྲིན་ སྒྲ་མེད་བཟོ་ཡི
quiet-sender-unmuted = { $address } ལས་གློག་འཕྲིན་གྱིས་ ལོག་བརྡ་བསྐུལ་འབདཝ་ཨིན
