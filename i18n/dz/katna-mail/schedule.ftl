## The menu beside Send

schedule-send = གཏང་ནིའི་དུས་ཚོད་བཀོད།
schedule-scheduled-messages = དུས་ཚོད་བཀོད་ཡོད་པའི་འཕྲིན་དོན་ཚུ ({ $count })

## Schedule send's suggested times

schedule-title = གཏང་ནིའི་དུས་ཚོད་བཀོད།
schedule-zone-note = { $zone }། གློག་རིམ་ཁ་བསྡམས་ཡོད་རུང་ Katna གིས་ དུས་ཚོད་དེ་ལུ་གཏངམ་ཨིན།
schedule-local-time = ས་གནས་ཀྱི་ཆུ་ཚོད
schedule-this-morning = ད་རིས་ཀྱི་ཞོགས་པ
schedule-this-afternoon = ད་རིས་ཀྱི་ཕྱི་ཆ
schedule-tomorrow-morning = ནངས་པ་ཞོགས་པ
schedule-tomorrow-afternoon = ནངས་པ་ཕྱི་ཆ
schedule-monday-morning = ཟླ་བའི་ཞོགས་པ
schedule-pick = ཚེས་གྲངས་དང་ཆུ་ཚོད་གདམ།

## The date and time picker

schedule-not-a-time = “{ $text }” འདི་ ཆུ་ཚོད་མེན། དཔེར་ན་ { $example }།
schedule-no-such-time = ཆུ་ཚོད་དེ་ ནཱ་ལུ་མེད།

## The list of scheduled mail

schedule-no-subject = (དོན་ཚན་མེད)
schedule-sends-at = { $when } ལུ་གཏང་འོང་།
schedule-cancel-send = གཏང་ནི་ཆ་མེད་གཏང་།
schedule-nothing = དུས་ཚོད་བཀོད་ཡོདཔ་ག་ནི་ཡང་མེད།
schedule-close = ཁ་བསྡམས།
schedule-open-first = ཁ་ཕྱེ་ཡོད་པའི་འཕྲིན་དོན་དེ་ ཧེ་མ་ལས་གཏང་ ཡང་ན་བཏོན་གཏང་།
schedule-cancelled = གཏང་ནི་ཆ་མེད་གཏང་ཡི། འཕྲིན་དོན་འདི་ ཞུན་དག་འབད་ནི་ལུ་ཁ་ཕྱེ་ཡོདཔ་ཨིན།
schedule-cancelled-not-opened = གཏང་ནི་ཆ་མེད་གཏང་ཡི། འཕྲིན་དོན་འདི་ ལོག་ཁ་ཕྱེ་མ་ཚུགས།
