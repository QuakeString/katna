## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Silenzia le notifiche
quiet-tip-off = Silenziato. Fai clic per riattivare le notifiche
quiet-tip-muted-until = Silenziato fino a { $when }. Fai clic per riattivare le notifiche

## The right-click menu of a folder or an account

quiet-mute = Silenzia…
quiet-unmute = Riattiva
quiet-notify = Notifica la nuova posta

## How long to mute

quiet-for-hour = Per 1 ora
quiet-until-tomorrow = Fino a domani mattina
quiet-until-unmuted = Finché non lo riattivo
quiet-turn-on = Notifica la nuova posta

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } silenziato
quiet-muted-until = { $name } silenziato fino a { $when }
quiet-on = { $name } notifica di nuovo

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Silenzia conversazione
quiet-unmute-conversation = Riattiva conversazione
quiet-mute-sender = Silenzia mittente
quiet-unmute-sender = Riattiva mittente
quiet-row-muted = Silenziata
quiet-conversation-strip = Silenziata. Le nuove risposte non verranno notificate né contate.
quiet-conversation-muted = { $count ->
    [one] Conversazione silenziata
    [many] { $count } di conversazioni silenziate
   *[other] { $count } conversazioni silenziate
}
quiet-conversation-unmuted = { $count ->
    [one] Conversazione riattivata
    [many] { $count } di conversazioni riattivate
   *[other] { $count } conversazioni riattivate
}
quiet-sender-strip = Silenziato. La sua posta non verrà notificata né contata.
quiet-sender-muted = Posta da { $address } silenziata
quiet-sender-unmuted = La posta da { $address } viene di nuovo notificata
