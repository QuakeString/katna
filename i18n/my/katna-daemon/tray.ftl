## The tray icon's tooltip, under "Katna Mail"

tray-unread = { $count ->
    [0] မဖတ်ရသေးသော စာ မရှိပါ
   *[other] မဖတ်ရသေးသော မက်ဆေ့ဂျ် { $count } စောင်
}
tray-password-refused = { $address } အတွက် စကားဝှက်အသစ် လိုအပ်သည်
tray-signed-out = { $address } သို့ ထပ်မံ ဝင်ရောက်ပါ
tray-accounts-need-you = အကောင့် { $count } ခုက သင့်ကို လိုအပ်နေသည်
tray-not-sent = { $count ->
   *[other] မက်ဆေ့ဂျ် { $count } စောင် မပို့ရပါ
}
