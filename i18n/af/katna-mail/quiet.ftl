## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Demp kennisgewings
quiet-tip-off = Gedemp. Klik om weer kennis te gee
quiet-tip-muted-until = Gedemp tot { $when }. Klik om weer kennis te gee

## The right-click menu of a folder or an account

quiet-mute = Demp…
quiet-unmute = Ontdemp
quiet-notify = Gee kennis van nuwe e-pos

## How long to mute

quiet-for-hour = Vir 1 uur
quiet-until-tomorrow = Tot môreoggend
quiet-until-unmuted = Totdat ek dit weer aanskakel
quiet-turn-on = Gee kennis van nuwe e-pos

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } gedemp
quiet-muted-until = { $name } gedemp tot { $when }
quiet-on = { $name } gee weer kennis

