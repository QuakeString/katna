rules-editor-saving = በማስቀመጥ ላይ…
rules-editor-delete = ደንቡን ሰርዝ
rules-editor-delete-ask = ይህ ደንብ ይሰረዝ?
rules-editor-delete-keep = አቆየው
rules-editor-delete-confirm = ሰርዝ
rules-editor-needs-folder = ለእያንዳንዱ «ውሰድ ወደ» አቃፊ እና ለእያንዳንዱ «መሰየሚያ አክል» መሰየሚያ ይምረጡ።
rules-editor-needs-days = «እንደተነበበ ምልክት አድርግ ከ» ከ1 እስከ 3650 የሚደርስ የቀናት ቁጥር ይወስዳል።
rules-saved = ደንቡ ተቀምጧል
rules-saved-applied = { $count ->
    [one] ደንቡ ተቀምጦ በ{ $count } ደብዳቤ ላይ ተተግብሯል
   *[other] ደንቡ ተቀምጦ በ{ $count } ደብዳቤዎች ላይ ተተግብሯል
}
rules-apply-failed = ደንቡ ተቀምጧል፣ ግን መተግበሩ አልተሳካም፦ { $error }
rules-deleted = ደንቡ ተሰርዟል
rules-delete-failed = ደንቡን መሰረዝ አልተቻለም፦ { $error }
rules-change-failed = ደንቦቹን መቀየር አልተቻለም፦ { $error }
