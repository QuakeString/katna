## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Silenciar notificações
quiet-tip-off = Silenciado. Clique para notificar de novo
quiet-tip-muted-until = Silenciado até { $when }. Clique para notificar de novo

## The right-click menu of a folder or an account

quiet-mute = Silenciar…
quiet-unmute = Reativar som
quiet-notify = Notificar sobre novos e-mails

## How long to mute

quiet-for-hour = Por 1 hora
quiet-until-tomorrow = Até amanhã de manhã
quiet-until-unmuted = Até eu reativar
quiet-turn-on = Notificar sobre novos e-mails

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } silenciado
quiet-muted-until = { $name } silenciado até { $when }
quiet-on = { $name } notifica de novo

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Silenciar conversa
quiet-unmute-conversation = Reativar conversa
quiet-mute-sender = Silenciar remetente
quiet-unmute-sender = Reativar remetente
quiet-row-muted = Silenciada
quiet-conversation-strip = Silenciada. Novas respostas não notificam nem contam.
quiet-conversation-muted = { $count ->
    [one] Conversa silenciada
    [many] { $count } de conversas silenciadas
   *[other] { $count } conversas silenciadas
}
quiet-conversation-unmuted = { $count ->
    [one] Conversa reativada
    [many] { $count } de conversas reativadas
   *[other] { $count } conversas reativadas
}
quiet-sender-strip = Silenciado. Os e-mails dele não notificam nem contam.
quiet-sender-muted = E-mails de { $address } silenciados
quiet-sender-unmuted = E-mails de { $address } notificam de novo
