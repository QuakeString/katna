## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Bisukan notifikasi
quiet-tip-off = Dibisukan. Klik untuk memberi notifikasi lagi
quiet-tip-muted-until = Dibisukan hingga { $when }. Klik untuk memberi notifikasi lagi

## The right-click menu of a folder or an account

quiet-mute = Bisukan…
quiet-unmute = Bunyikan
quiet-notify = Beri notifikasi untuk email baru

## How long to mute

quiet-for-hour = Selama 1 jam
quiet-until-tomorrow = Sampai besok pagi
quiet-until-unmuted = Sampai saya mengaktifkannya lagi
quiet-turn-on = Beri notifikasi untuk email baru

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } dibisukan
quiet-muted-until = { $name } dibisukan hingga { $when }
quiet-on = { $name } kembali memberi notifikasi

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Bisukan percakapan
quiet-unmute-conversation = Bunyikan percakapan
quiet-mute-sender = Bisukan pengirim
quiet-unmute-sender = Bunyikan pengirim
quiet-row-muted = Dibisukan
quiet-conversation-strip = Dibisukan. Balasan baru tidak akan memberi notifikasi atau dihitung.
quiet-conversation-muted = { $count ->
   *[other] { $count } percakapan dibisukan
}
quiet-conversation-unmuted = { $count ->
   *[other] { $count } percakapan dibunyikan lagi
}
quiet-sender-strip = Dibisukan. Email dari pengirim ini tidak akan memberi notifikasi atau dihitung.
quiet-sender-muted = Email dari { $address } dibisukan
quiet-sender-unmuted = Email dari { $address } kembali memberi notifikasi
