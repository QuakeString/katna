# Katna Mail, English: lines printed in the terminal when Katna Mail is
# started from one. Guide: i18n/README.md. Keep ids stable; change the text
# freely.

# Katna Mail was already running; it was asked to show its window.
launch-showing-window = Katna Mail is already running; showing its window.
# The running Katna Mail did not answer, so this one starts in its place.
launch-not-answering = The running Katna Mail isn't answering, so a new one is starting.
