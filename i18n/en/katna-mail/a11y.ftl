# Katna Mail, English: what screen readers (Orca, NVDA) say about parts of
# the window that have no visible words of their own.
# Guide: i18n/README.md. Keep ids stable; change the text freely.

## The mail list

# The list of mail, as a whole.
a11y-mail-list = Mail
# Said first on a line of unread mail, before its sender and subject.
a11y-unread = Unread

## The folder pane

# The folder pane, as a whole.
a11y-folders = Folders
# A folder with unread mail: { $name } is the folder, { $count } how many
# are unread.
a11y-folder-unread = { $name }, { $count } unread
