# Katna Mail, English: automatic translation (the bar above a message in
# another language, and the reading-language picker).
# Guide: i18n/README.md. Keep ids stable; change the text freely.
# { $language } is a language's own name, such as Español.

translate-offer = This message is in { $language }.
translate-to = Translate to { $language }
translate-never = Never for { $language }
translate-working = Translating…
translate-done = Translated from { $language }.
translate-done-unknown = Translated.
translate-show-original = Show original
translate-show-translation = Show translation
translate-always = Always translate { $language }
translate-failed = Could not translate this message.
translate-retry = Try again
translate-too-many = Too many translations for now. Try again later.
translate-sign-in = This message is in { $language }. Sign in to a Katna account to translate it.
translate-unsupported = Katna's server cannot translate { $language } yet.
translate-reading-same = Same as Katna
translate-reading-same-now = Same as Katna ({ $language })
