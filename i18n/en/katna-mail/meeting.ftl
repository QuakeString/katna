# Katna Mail, English: video calls around mail (Start a video call, and the
# Join buttons under mail with a call link).
# Guide: i18n/README.md. Keep ids stable; change the text freely.

# Shown while the call's link is made.
meeting-starting = Starting a video call…
# Subject of the new mail with a call's link. $subject: the conversation's.
meeting-mail-subject = Video call: { $subject }
# The same, for a conversation without a subject.
meeting-mail-subject-plain = Video call
# Body of the new mail. $link: the call's address.
meeting-mail-body = Join the video call: { $link }
# Put in the message before the call's link.
meeting-join-line = Join the video call:
# Beside a call link's Join button under a mail. $service: the name below.
meeting-call-on = Video call on { $service }
meeting-join = Join

## Service names, as each service writes its own.

meeting-service-google-meet = Google Meet
meeting-service-teams = Microsoft Teams
meeting-service-zoom = Zoom
meeting-service-webex = Webex
meeting-service-jitsi = Jitsi Meet
meeting-service-whatsapp = WhatsApp
meeting-service-telegram = Telegram
