# Katna Mail, Swahili (Kiswahili).
# Machine-drafted by AI; not yet reviewed by a native speaker.
# Corrections welcome: see i18n/README.md.

## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Nyamazisha arifa
quiet-tip-off = Imenyamazishwa. Bofya ili kuarifu tena
quiet-tip-muted-until = Imenyamazishwa hadi { $when }. Bofya ili kuarifu tena

## The right-click menu of a folder or an account

quiet-mute = Nyamazisha…
quiet-unmute = Acha kunyamazisha
quiet-notify = Arifu kuhusu barua mpya

## How long to mute

quiet-for-hour = Kwa saa 1
quiet-until-tomorrow = Hadi kesho asubuhi
quiet-until-unmuted = Hadi nitakapoiwasha tena
quiet-turn-on = Arifu kuhusu barua mpya

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } imenyamazishwa
quiet-muted-until = { $name } imenyamazishwa hadi { $when }
quiet-on = { $name } inaarifu tena

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Nyamazisha mazungumzo
quiet-unmute-conversation = Acha kunyamazisha mazungumzo
quiet-mute-sender = Nyamazisha mtumaji
quiet-unmute-sender = Acha kunyamazisha mtumaji
quiet-row-muted = Imenyamazishwa
quiet-conversation-strip = Yamenyamazishwa. Majibu mapya hayataarifu wala kuhesabiwa.
quiet-conversation-muted = { $count ->
    [one] Mazungumzo yamenyamazishwa
   *[other] Mazungumzo { $count } yamenyamazishwa
}
quiet-conversation-unmuted = { $count ->
    [one] Mazungumzo hayajanyamazishwa tena
   *[other] Mazungumzo { $count } hayajanyamazishwa tena
}
quiet-sender-strip = Amenyamazishwa. Barua zake hazitaarifu wala kuhesabiwa.
quiet-sender-muted = Barua kutoka { $address } zimenyamazishwa
quiet-sender-unmuted = Barua kutoka { $address } zinaarifu tena
