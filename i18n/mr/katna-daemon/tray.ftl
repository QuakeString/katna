## The tray icon's menu

tray-open-inbox = _इनबॉक्स उघडा
tray-new-message = _नवीन मेसेज
tray-new-task = नवीन _कार्य
tray-new-note = नवीन _नोट
tray-preferences = _सेटिंग्ज
tray-quit = _बाहेर पडा

## The tray icon's tooltip

tray-unread = { $count ->
    [0] न वाचलेले मेल नाहीत
    [one] { $count } न वाचलेला मेसेज
   *[other] { $count } न वाचलेले मेसेज
}
tray-password-refused = { $address } साठी नवीन पासवर्ड हवा
tray-signed-out = { $address } मध्ये पुन्हा साइन इन करा
tray-accounts-need-you = { $count } खात्यांना तुमची गरज आहे
tray-not-sent = { $count ->
    [one] { $count } मेसेज पाठवला गेला नाही
   *[other] { $count } मेसेज पाठवले गेले नाहीत
}
