## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = सूचना म्यूट करा
quiet-tip-off = म्यूट केले. पुन्हा सूचित करण्यासाठी क्लिक करा
quiet-tip-muted-until = { $when } पर्यंत म्यूट. पुन्हा सूचित करण्यासाठी क्लिक करा

## The right-click menu of a folder or an account

quiet-mute = म्यूट करा…
quiet-unmute = अनम्यूट करा
quiet-notify = नवीन मेलबद्दल सूचित करा

## How long to mute

quiet-for-hour = 1 तासासाठी
quiet-until-tomorrow = उद्या सकाळपर्यंत
quiet-until-unmuted = मी पुन्हा सुरू करेपर्यंत
quiet-turn-on = नवीन मेलबद्दल सूचित करा

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } म्यूट केले
quiet-muted-until = { $name } { $when } पर्यंत म्यूट केले
quiet-on = { $name } पुन्हा सूचित करते

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = संभाषण म्यूट करा
quiet-unmute-conversation = संभाषण अनम्यूट करा
quiet-mute-sender = प्रेषक म्यूट करा
quiet-unmute-sender = प्रेषक अनम्यूट करा
quiet-row-muted = म्यूट केलेले
quiet-conversation-strip = म्यूट केलेले. नवीन उत्तरांची सूचना येणार नाही किंवा ती मोजली जाणार नाहीत.
quiet-conversation-muted = { $count ->
    [one] संभाषण म्यूट केले
   *[other] { $count } संभाषणे म्यूट केली
}
quiet-conversation-unmuted = { $count ->
    [one] संभाषण अनम्यूट केले
   *[other] { $count } संभाषणे अनम्यूट केली
}
quiet-sender-strip = म्यूट केलेले. त्यांच्या मेलची सूचना येणार नाही किंवा तो मोजला जाणार नाही.
quiet-sender-muted = { $address } कडील मेल म्यूट केला
quiet-sender-unmuted = { $address } कडील मेल पुन्हा सूचित करतो
