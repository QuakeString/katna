## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Pa ohùn ìfitónilétí
quiet-tip-off = Ohùn ti pa. Tẹ̀ ẹ́ láti máa fi tó ọ létí lẹ́ẹ̀kan sí i
quiet-tip-muted-until = Ohùn ti pa títí di { $when }. Tẹ̀ ẹ́ láti máa fi tó ọ létí lẹ́ẹ̀kan sí i

## The right-click menu of a folder or an account

quiet-mute = Pa ohùn…
quiet-unmute = Dá ohùn padà
quiet-notify = Fi tó mi létí fún lẹ́tà tuntun

## How long to mute

quiet-for-hour = Fún wákàtí 1
quiet-until-tomorrow = Títí di òwúrọ̀ ọ̀la
quiet-until-unmuted = Títí màá fi tàn án padà
quiet-turn-on = Fi tó mi létí fún lẹ́tà tuntun

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = A ti pa ohùn { $name }
quiet-muted-until = A ti pa ohùn { $name } títí di { $when }
quiet-on = { $name } tún ń fi tó ọ létí

