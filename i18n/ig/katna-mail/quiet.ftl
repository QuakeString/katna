## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Mee ka ọkwa gbachi nkịtị
quiet-tip-off = Agbachiri nkịtị. Pịa ka ọ kpọọ ọkwa ọzọ
quiet-tip-muted-until = Agbachiri nkịtị ruo { $when }. Pịa ka ọ kpọọ ọkwa ọzọ

## The right-click menu of a folder or an account

quiet-mute = Mee ka ọ gbachi nkịtị…
quiet-unmute = Kwụsị ịgbachi nkịtị
quiet-notify = Kpọọ ọkwa maka ozi ọhụrụ

## How long to mute

quiet-for-hour = Ruo otu awa
quiet-until-tomorrow = Ruo ụtụtụ echi
quiet-until-unmuted = Ruo mgbe m gbanyere ya ọzọ
quiet-turn-on = Kpọọ ọkwa maka ozi ọhụrụ

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } agbachiri nkịtị
quiet-muted-until = { $name } agbachiri nkịtị ruo { $when }
quiet-on = { $name } na-akpọ ọkwa ọzọ

