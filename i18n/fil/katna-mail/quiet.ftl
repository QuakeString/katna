# Katna Mail, Filipino (Filipino).
# Machine-drafted by AI; not yet reviewed by a native speaker.
# Corrections welcome: see i18n/README.md.

## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = I-mute ang mga notification
quiet-tip-off = Naka-mute. I-click para mag-abiso ulit
quiet-tip-muted-until = Naka-mute hanggang { $when }. I-click para mag-abiso ulit

## The right-click menu of a folder or an account

quiet-mute = I-mute…
quiet-unmute = I-unmute
quiet-notify = Mag-abiso para sa bagong mail

## How long to mute

quiet-for-hour = Sa loob ng 1 oras
quiet-until-tomorrow = Hanggang bukas ng umaga
quiet-until-unmuted = Hanggang i-on ko ulit
quiet-turn-on = Mag-abiso para sa bagong mail

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = Naka-mute ang { $name }
quiet-muted-until = Naka-mute ang { $name } hanggang { $when }
quiet-on = Nag-aabiso na ulit ang { $name }

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = I-mute ang pag-uusap
quiet-unmute-conversation = I-unmute ang pag-uusap
quiet-mute-sender = I-mute ang nagpadala
quiet-unmute-sender = I-unmute ang nagpadala
quiet-row-muted = Naka-mute
quiet-conversation-strip = Naka-mute. Hindi mag-aabiso o mabibilang ang mga bagong sagot.
quiet-conversation-muted = { $count ->
    [one] Na-mute ang pag-uusap
   *[other] Na-mute ang { $count } pag-uusap
}
quiet-conversation-unmuted = { $count ->
    [one] Na-unmute ang pag-uusap
   *[other] Na-unmute ang { $count } pag-uusap
}
quiet-sender-strip = Naka-mute. Hindi mag-aabiso o mabibilang ang mail nila.
quiet-sender-muted = Na-mute ang mail mula sa { $address }
quiet-sender-unmuted = Nag-aabiso na ulit ang mail mula sa { $address }
