tour-back = ಹಿಂದೆ
tour-done = ಮುಗಿದಿದೆ
tour-next = ಮುಂದೆ
tour-step = { $total } ರಲ್ಲಿ { $step }
tour-compose-title = ಸಂದೇಶ ಬರೆಯಿರಿ
tour-compose-text = ರಚಿಸಿ ಬಟನ್ ಕೆಳಗಿನ ಬಲಭಾಗದಲ್ಲಿ ಹೊಸ ಸಂದೇಶವನ್ನು ತೆರೆಯುತ್ತದೆ, ಆದ್ದರಿಂದ ಬರೆಯುತ್ತಿರುವಾಗಲೂ ನೀವು ಓದುವುದನ್ನು ಮುಂದುವರಿಸಬಹುದು.
tour-search-title = ನಿಮ್ಮ ಎಲ್ಲಾ ಮೇಲ್ ಹುಡುಕಿ
tour-search-text = ಹುಡುಕಾಟ ಆಫ್‌ಲೈನ್‌ನಲ್ಲೂ ಕೆಲಸ ಮಾಡುತ್ತದೆ. ಬಲ ತುದಿಯಲ್ಲಿರುವ ಬಟನ್ ಫಿಲ್ಟರ್‌ಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ: ಕಳುಹಿಸುವವರು, ಸ್ವೀಕರಿಸುವವರು, ವಿಷಯ, ದಿನಾಂಕಗಳು ಮತ್ತು ಲಗತ್ತುಗಳು.
tour-menu-title = ಫೋಲ್ಡರ್‌ಗಳನ್ನು ತೋರಿಸಿ ಅಥವಾ ಮರೆಮಾಡಿ
tour-menu-text = ಈ ಬಟನ್ ಫೋಲ್ಡರ್ ಪಟ್ಟಿಯನ್ನು ಮಡಚುತ್ತದೆ. ಅದು ಮರೆಯಾಗಿರುವಾಗ, ಫೋಲ್ಡರ್‌ಗಳನ್ನು ನೋಡಲು ಎಡಭಾಗದಲ್ಲಿರುವ ಮೇಲ್ ಮೇಲೆ ಪಾಯಿಂಟರ್ ಇಡಿ.
tour-apps-title = ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು
tour-apps-text = ಈಗ ಇಲ್ಲಿ ಮೇಲ್ ಇದೆ. ಕ್ಯಾಲೆಂಡರ್, ಸಂಪರ್ಕಗಳು, ಕಾರ್ಯಗಳು, ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಫೀಡ್‌ಗಳು ಈ ಪಟ್ಟಿಗೆ ಸೇರಲಿವೆ.
tour-tabs-title = ಇನ್‌ಬಾಕ್ಸ್ ಟ್ಯಾಬ್‌ಗಳು
tour-tabs-text = ಹೊಸ ಮೇಲ್ ಅನ್ನು ಪ್ರಾಥಮಿಕ, ಪ್ರಚಾರಗಳು, ಸಾಮಾಜಿಕ, ಅಪ್‌ಡೇಟ್‌ಗಳು ಮತ್ತು ಫೋರಮ್‌ಗಳು ಎಂದು ವಿಂಗಡಿಸಲಾಗುತ್ತದೆ. ತ್ವರಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಆಫ್ ಮಾಡಬಹುದು.
tour-list-title = ನಿಮ್ಮ ಸಂದೇಶಗಳು
tour-list-text = ಸಂದೇಶವನ್ನು ಓದಲು ಅದರ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ. ತ್ವರಿತ ಕ್ರಿಯೆಗಳಿಗಾಗಿ ಅದರ ಮೇಲೆ ಪಾಯಿಂಟರ್ ಇಡಿ, ಇನ್ನಷ್ಟಕ್ಕಾಗಿ ರೈಟ್-ಕ್ಲಿಕ್ ಮಾಡಿ, ಅಥವಾ ಹಲವನ್ನು ಒಟ್ಟಿಗೆ ನಿರ್ವಹಿಸಲು ಅವುಗಳನ್ನು ಗುರುತಿಸಿ.
tour-settings-title = ತ್ವರಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳು
tour-settings-text = ಓದುವ ಫಲಕ, ಸಾಂದ್ರತೆ ಮತ್ತು ಥೀಮ್ ಅನ್ನು ಇಲ್ಲಿ ಬದಲಾಯಿಸಿ. ಪ್ರವಾಸವನ್ನು ಇಲ್ಲಿಂದಲೂ ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಬಹುದು.
tour-account-title = ನಿಮ್ಮ ಖಾತೆ
tour-account-text = ನೀವು ಯಾವ ಖಾತೆಯಲ್ಲಿದ್ದೀರಿ ಎಂದು ನೋಡಿ, ಮತ್ತು ಇನ್ನೊಂದನ್ನು ಸೇರಿಸಿ.

