## Encrypted and signed mail

security-decrypting = ಡೀಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ…
security-checking = ಸಹಿಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ…
security-partly-encrypted = ಈ ಸಂದೇಶದ ಒಂದು ಭಾಗ ಮಾತ್ರ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿದೆ. ಉಳಿದ ಭಾಗವನ್ನು ರಕ್ಷಣೆಯ ಹೊರಗೆ ಸೇರಿಸಲಾಗಿದೆ ಮತ್ತು ಅದು ಯಾರಿಂದಲಾದರೂ ಬಂದಿರಬಹುದು.
security-partly-signed = ಈ ಸಂದೇಶದ ಒಂದು ಭಾಗಕ್ಕೆ ಮಾತ್ರ ಸಹಿ ಇದೆ. ಉಳಿದ ಭಾಗವನ್ನು ರಕ್ಷಣೆಯ ಹೊರಗೆ ಸೇರಿಸಲಾಗಿದೆ ಮತ್ತು ಅದು ಯಾರಿಂದಲಾದರೂ ಬಂದಿರಬಹುದು.
security-encrypted = ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಸಂದೇಶ
security-encrypted-smime = ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಸಂದೇಶ (S/MIME)
security-no-key = ಈ ಸಂದೇಶವನ್ನು ಡೀಕ್ರಿಪ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ: ಇದನ್ನು ನಿಮ್ಮ ಬಳಿ ಇಲ್ಲದ ಕೀಗಾಗಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗಿದೆ.
security-cancelled = ಡೀಕ್ರಿಪ್ಟ್ ಮಾಡುವುದನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗಿದೆ.
security-damaged = ಈ ಸಂದೇಶವನ್ನು ಡೀಕ್ರಿಪ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ: ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಡೇಟಾ ಹಾಳಾಗಿದೆ ಅಥವಾ ಬದಲಾಗಿದೆ.
security-decrypt-unavailable = ಈ ಸಂದೇಶವನ್ನು ಡೀಕ್ರಿಪ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ: ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಮೇಲ್ ಓದಲು { $tool } ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ.
security-decrypt-failed = ಈ ಸಂದೇಶವನ್ನು ಡೀಕ್ರಿಪ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ: { $reason }
security-unknown-signer = ಅಜ್ಞಾತ ಸಹಿದಾರರು
security-signed-verified = { $signer } ಅವರಿಂದ ಸಹಿ ಮಾಡಲಾಗಿದೆ · ಪರಿಶೀಲಿಸಲಾಗಿದೆ
security-signed-not-sender = { $signer } ಅವರಿಂದ ಸಹಿ ಮಾಡಲಾಗಿದೆ, ಅವರು ಕಳುಹಿಸುವವರಲ್ಲ
security-signed-untrusted = ನೀವು ವಿಶ್ವಾಸಾರ್ಹವಲ್ಲ ಎಂದು ಗುರುತಿಸಿದ ಕೀಯೊಂದಿಗೆ { $signer } ಅವರಿಂದ ಸಹಿ ಮಾಡಲಾಗಿದೆ
security-signed-unverified = { $signer } ಅವರಿಂದ ಸಹಿ ಮಾಡಲಾಗಿದೆ · ಕೀ ಪರಿಶೀಲಿಸಲಾಗಿಲ್ಲ
security-bad-signature = ತಪ್ಪಾದ ಸಹಿ: ಈ ಸಂದೇಶಕ್ಕೆ ಸಹಿ ಮಾಡಿದ ನಂತರ ಅದನ್ನು ಬದಲಾಯಿಸಲಾಗಿದೆ, ಅಥವಾ ಸಹಿ ನಕಲಿಯಾಗಿದೆ.
security-signature-expired = { $signer } ಅವರಿಂದ ಸಹಿ ಮಾಡಲಾಗಿದೆ · ಸಹಿಯ ಅವಧಿ ಮುಗಿದಿದೆ
security-key-expired = { $signer } ಅವರಿಂದ ಸಹಿ ಮಾಡಲಾಗಿದೆ · ಅಂದಿನಿಂದ ಕೀಯ ಅವಧಿ ಮುಗಿದಿದೆ
security-key-revoked = ಹಿಂಪಡೆಯಲಾದ ಕೀಯೊಂದಿಗೆ { $signer } ಅವರಿಂದ ಸಹಿ ಮಾಡಲಾಗಿದೆ
security-missing-key = ನಿಮ್ಮ ಬಳಿ ಇಲ್ಲದ ಕೀಯೊಂದಿಗೆ ಸಹಿ ಮಾಡಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಅದನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ
security-missing-key-id = ನಿಮ್ಮ ಬಳಿ ಇಲ್ಲದ ಕೀಯೊಂದಿಗೆ ({ $key }) ಸಹಿ ಮಾಡಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಅದನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ
security-signature-unavailable = ಸಹಿ ಮಾಡಲಾಗಿದೆ; ಸಹಿಯನ್ನು ಪರಿಶೀಲಿಸಲು { $tool } ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ
security-signature-error = ಸಹಿಯನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.

## Remote images and pictures

remote-hidden = ಈ ಸಂದೇಶದಲ್ಲಿನ ಚಿತ್ರಗಳನ್ನು ಮರೆಮಾಡಲಾಗಿದೆ.
remote-show = ಚಿತ್ರಗಳನ್ನು ತೋರಿಸಿ
remote-always-show = ಈ ಕಳುಹಿಸುವವರಿಂದ ಯಾವಾಗಲೂ ತೋರಿಸಿ
remote-picture-use = ಬಳಸಿ
remote-picture-too-big = 8 MB ಅಥವಾ ಅದಕ್ಕಿಂತ ಕಡಿಮೆ ಗಾತ್ರದ ಚಿತ್ರವನ್ನು ಆರಿಸಿ.
remote-picture-type = PNG, JPEG, GIF, WebP ಅಥವಾ SVG ಚಿತ್ರವನ್ನು ಆರಿಸಿ.
remote-picture-read-failed = ಚಿತ್ರವನ್ನು ಓದಲು ಸಾಧ್ಯವಿಲ್ಲ: { $error }
remote-picture-keep-failed = ಚಿತ್ರವನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ: { $error }
remote-picture-remove-failed = ಚಿತ್ರವನ್ನು ತೆಗೆದುಹಾಕಲು ಸಾಧ್ಯವಿಲ್ಲ: { $error }

## Attachments

attachment-count = { $count ->
    [one] ಒಂದು ಲಗತ್ತು
   *[other] { $count } ಲಗತ್ತುಗಳು
}
attachment-save = ಉಳಿಸಿ
attachment-save-all = ಎಲ್ಲವನ್ನೂ ಉಳಿಸಿ
attachment-save-all-tooltip = ಎಲ್ಲಾ ಲಗತ್ತುಗಳನ್ನು ಒಂದು ಫೋಲ್ಡರ್‌ಗೆ ಉಳಿಸಿ
attachment-save-here = ಇಲ್ಲಿ ಉಳಿಸಿ
attachment-not-downloaded = ಈ ಸಂದೇಶವನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗಿಲ್ಲ.
attachment-not-found = ಈ ಲಗತ್ತು ಸಂದೇಶದಲ್ಲಿ ಕಂಡುಬರಲಿಲ್ಲ.
attachment-read-failed = { $name } ಅನ್ನು ಓದಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ
attachment-numbered = ಲಗತ್ತು { $number }
attachment-saved-all = { $count ->
    [one] { $count } ಫೈಲ್ ಅನ್ನು { $place } ಗೆ ಉಳಿಸಲಾಗಿದೆ
   *[other] { $count } ಫೈಲ್‌ಗಳನ್ನು { $place } ಗೆ ಉಳಿಸಲಾಗಿದೆ
}
attachment-saved-some = { $total ->
    [one] { $total } ಫೈಲ್‌ನಲ್ಲಿ { $saved } ಅನ್ನು { $place } ಗೆ ಉಳಿಸಲಾಗಿದೆ. { $failed } ಅನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ
   *[other] { $total } ಫೈಲ್‌ಗಳಲ್ಲಿ { $saved } ಅನ್ನು { $place } ಗೆ ಉಳಿಸಲಾಗಿದೆ. { $failed } ಅನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ
}
attachment-saved-to = { $path } ಗೆ ಉಳಿಸಲಾಗಿದೆ
attachment-save-failed = { $name } ಅನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: { $error }
attachment-open-failed = { $name } ಅನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: { $error }
attachment-risky = ಈ ಫೈಲ್ ಪ್ರೋಗ್ರಾಂ ಅನ್ನು ರನ್ ಮಾಡಬಹುದು, ಆದ್ದರಿಂದ Katna ಇದನ್ನು ತೆರೆಯುವುದಿಲ್ಲ. ಬದಲಿಗೆ ಇದನ್ನು ಉಳಿಸಿ.
attachment-encrypted-open = ಈ ಫೈಲ್ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿ ಬಂದಿದೆ. ಬೇರೆಡೆ ತೆರೆಯಲು ಇದನ್ನು ಉಳಿಸಿ.

## Printing

print-failed = ಮುದ್ರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: { $error }
print-no-font = ಯಾವುದೇ ಫಾಂಟ್ ಕಂಡುಬಂದಿಲ್ಲ
print-opened-as-pdf = ಅಲ್ಲಿಂದ ಮುದ್ರಿಸಲು PDF ಆಗಿ ತೆರೆಯಲಾಗಿದೆ.
print-not-downloaded = (ಇನ್ನೂ ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗಿಲ್ಲ.)
print-encrypted = (ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗಿದೆ. ಇದರ ಪಠ್ಯವನ್ನು ಮುದ್ರಿಸಲು Katna Mail ನಲ್ಲಿ ತೆರೆಯಿರಿ.)
print-to = ಇವರಿಗೆ: { $addresses }
print-cc = Cc: { $addresses }
