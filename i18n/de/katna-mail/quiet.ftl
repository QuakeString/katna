## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Benachrichtigungen stummschalten
quiet-tip-off = Stummgeschaltet. Klicken, um wieder zu benachrichtigen
quiet-tip-muted-until = Stummgeschaltet bis { $when }. Klicken, um wieder zu benachrichtigen

## The right-click menu of a folder or an account

quiet-mute = Stummschalten…
quiet-unmute = Stummschaltung aufheben
quiet-notify = Bei neuen E-Mails benachrichtigen

## How long to mute

quiet-for-hour = Für 1 Stunde
quiet-until-tomorrow = Bis morgen früh
quiet-until-unmuted = Bis ich es wieder einschalte
quiet-turn-on = Bei neuen E-Mails benachrichtigen

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } stummgeschaltet
quiet-muted-until = { $name } stummgeschaltet bis { $when }
quiet-on = { $name } benachrichtigt wieder

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Konversation stummschalten
quiet-unmute-conversation = Stummschaltung der Konversation aufheben
quiet-mute-sender = Absender stummschalten
quiet-unmute-sender = Stummschaltung des Absenders aufheben
quiet-row-muted = Stummgeschaltet
quiet-conversation-strip = Stummgeschaltet. Neue Antworten werden weder gemeldet noch gezählt.
quiet-conversation-muted = { $count ->
    [one] Konversation stummgeschaltet
   *[other] { $count } Konversationen stummgeschaltet
}
quiet-conversation-unmuted = { $count ->
    [one] Stummschaltung der Konversation aufgehoben
   *[other] Stummschaltung von { $count } Konversationen aufgehoben
}
quiet-sender-strip = Stummgeschaltet. E-Mails dieser Person werden weder gemeldet noch gezählt.
quiet-sender-muted = E-Mails von { $address } stummgeschaltet
quiet-sender-unmuted = E-Mails von { $address } benachrichtigen wieder
