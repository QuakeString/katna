## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = I-{ $name } ithulisiwe
quiet-muted-until = I-{ $name } ithulisiwe kuze kube ngu-{ $when }
quiet-on = I-{ $name } iyazisa futhi

