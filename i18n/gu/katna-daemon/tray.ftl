## The tray icon's tooltip

tray-unread = { $count ->
    [0] કોઈ ન વાંચેલો મેઇલ નથી
    [one] { $count } ન વાંચેલો મેસેજ
   *[other] { $count } ન વાંચેલા મેસેજ
}
tray-password-refused = { $address } માટે નવો પાસવર્ડ જરૂરી છે
tray-signed-out = { $address } માં ફરી સાઇન ઇન કરો
tray-accounts-need-you = { $count } એકાઉન્ટને તમારી જરૂર છે
tray-not-sent = { $count ->
    [one] { $count } મેસેજ મોકલાયો નથી
   *[other] { $count } મેસેજ મોકલાયા નથી
}
