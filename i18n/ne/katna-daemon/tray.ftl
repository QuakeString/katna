## The tray icon's menu

tray-open-inbox = _इनबक्स खोल्नुहोस्
tray-new-message = _नयाँ सन्देश
tray-new-task = नयाँ _कार्य
tray-new-note = नयाँ _टिपोट
tray-preferences = _सेटिङहरू
tray-quit = _बाहिरिनुहोस्

## The tray icon's tooltip

tray-unread = { $count ->
    [0] नपढिएको मेल छैन
   *[other] { $count } नपढिएको सन्देश
}
tray-password-refused = { $address } का लागि नयाँ पासवर्ड चाहिन्छ
tray-signed-out = { $address } मा फेरि साइन इन गर्नुहोस्
tray-accounts-need-you = { $count } खाताहरूलाई तपाईं चाहिएको छ
tray-not-sent = { $count ->
    [one] { $count } सन्देश पठाइएन
   *[other] { $count } सन्देशहरू पठाइएनन्
}
