app-contacts-count = { $count ->
    [one] तपाईंको मेलबाट { $count } जना व्यक्ति, सबैभन्दा धेरै लेखापढी गरिएका पहिले
   *[other] तपाईंको मेलबाट { $count } जना मानिसहरू, सबैभन्दा धेरै लेखापढी गरिएका पहिले
}
app-contacts-top = { $count ->
