## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = सूचनाहरू म्युट गर्नुहोस्
quiet-tip-off = म्युट गरिएको। फेरि सूचना दिन क्लिक गर्नुहोस्
quiet-tip-muted-until = { $when } सम्म म्युट गरिएको। फेरि सूचना दिन क्लिक गर्नुहोस्

## The right-click menu of a folder or an account

quiet-mute = म्युट गर्नुहोस्…
quiet-unmute = म्युट हटाउनुहोस्
quiet-notify = नयाँ मेलबारे सूचना दिनुहोस्

## How long to mute

quiet-for-hour = 1 घण्टाका लागि
quiet-until-tomorrow = भोलि बिहानसम्म
quiet-until-unmuted = मैले फेरि खोल्दासम्म
quiet-turn-on = नयाँ मेलबारे सूचना दिनुहोस्

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } म्युट गरियो
quiet-muted-until = { $name } { $when } सम्म म्युट गरियो
quiet-on = { $name } ले फेरि सूचना दिन्छ

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = वार्तालाप म्युट गर्नुहोस्
quiet-unmute-conversation = वार्तालापको म्युट हटाउनुहोस्
quiet-mute-sender = प्रेषक म्युट गर्नुहोस्
quiet-unmute-sender = प्रेषकको म्युट हटाउनुहोस्
quiet-row-muted = म्युट गरिएको
quiet-conversation-strip = म्युट गरिएको। नयाँ जवाफहरूले सूचना दिँदैनन् वा गनिँदैनन्।
quiet-conversation-muted = { $count ->
    [one] वार्तालाप म्युट गरियो
   *[other] { $count } वार्तालापहरू म्युट गरिए
}
quiet-conversation-unmuted = { $count ->
    [one] वार्तालापको म्युट हटाइयो
   *[other] { $count } वार्तालापहरूको म्युट हटाइयो
}
quiet-sender-strip = म्युट गरिएको। उहाँको मेलले सूचना दिँदैन वा गनिँदैन।
quiet-sender-muted = { $address } को मेल म्युट गरियो
quiet-sender-unmuted = { $address } को मेलले फेरि सूचना दिन्छ
