    [conversation] { $count ->
        [one] यो वार्तालाप सधैँका लागि मेटाउने?
       *[other] { $count } वार्तालापहरू सधैँका लागि मेटाउने?
    }
   *[message] { $count ->
        [one] यो सन्देश सधैँका लागि मेटाउने?
       *[other] { $count } सन्देशहरू सधैँका लागि मेटाउने?
    }
}
