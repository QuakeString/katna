## The tray icon's tooltip

tray-unread = { $count ->
    [0] کوئی ناخواندہ میل نہیں
    [one] { $count } ناخواندہ پیغام
   *[other] { $count } ناخواندہ پیغامات
}
tray-password-refused = { $address } کے لیے نیا پاس ورڈ درکار ہے
tray-signed-out = { $address } میں دوبارہ سائن ان کریں
tray-accounts-need-you = { $count } اکاؤنٹس کو آپ کی ضرورت ہے
tray-not-sent = { $count ->
    [one] { $count } پیغام نہیں بھیجا گیا
   *[other] { $count } پیغامات نہیں بھیجے گئے
}
