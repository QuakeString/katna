## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Wycisz powiadomienia
quiet-tip-off = Wyciszone. Kliknij, aby znów powiadamiać
quiet-tip-muted-until = Wyciszone do { $when }. Kliknij, aby znów powiadamiać

## The right-click menu of a folder or an account

quiet-mute = Wycisz…
quiet-unmute = Wyłącz wyciszenie
quiet-notify = Powiadamiaj o nowej poczcie

## How long to mute

quiet-for-hour = Na 1 godzinę
quiet-until-tomorrow = Do jutra rana
quiet-until-unmuted = Dopóki sam tego nie włączę
quiet-turn-on = Powiadamiaj o nowej poczcie

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = Wyciszono: { $name }
quiet-muted-until = Wyciszono: { $name }, do { $when }
quiet-on = { $name } znów powiadamia

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Wycisz wątek
quiet-unmute-conversation = Wyłącz wyciszenie wątku
quiet-mute-sender = Wycisz nadawcę
quiet-unmute-sender = Wyłącz wyciszenie nadawcy
quiet-row-muted = Wyciszony
quiet-conversation-strip = Wyciszony. Nowe odpowiedzi nie powiadamiają i nie są liczone.
quiet-conversation-muted = { $count ->
    [one] Wyciszono wątek
    [few] Wyciszono { $count } wątki
    [many] Wyciszono { $count } wątków
   *[other] Wyciszono { $count } wątku
}
quiet-conversation-unmuted = { $count ->
    [one] Wyłączono wyciszenie wątku
    [few] Wyłączono wyciszenie { $count } wątków
    [many] Wyłączono wyciszenie { $count } wątków
   *[other] Wyłączono wyciszenie { $count } wątku
}
quiet-sender-strip = Wyciszony. Jego poczta nie powiadamia i nie jest liczona.
quiet-sender-muted = Wyciszono pocztę od { $address }
quiet-sender-unmuted = Poczta od { $address } znów powiadamia
