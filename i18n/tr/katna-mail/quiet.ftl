## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Bildirimleri sessize al
quiet-tip-off = Sessizde. Yeniden bildirmek için tıklayın
quiet-tip-muted-until = { $when } zamanına kadar sessizde. Yeniden bildirmek için tıklayın

## The right-click menu of a folder or an account

quiet-mute = Sessize al…
quiet-unmute = Sesi aç
quiet-notify = Yeni postaları bildir

## How long to mute

quiet-for-hour = 1 saatliğine
quiet-until-tomorrow = Yarın sabaha kadar
quiet-until-unmuted = Ben yeniden açana kadar
quiet-turn-on = Yeni postaları bildir

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } sessize alındı
quiet-muted-until = { $name }, { $when } zamanına kadar sessize alındı
quiet-on = { $name } yeniden bildiriyor

## Conversations and senders (the reading pane's bell, the More menus and

## the right-click menu)

quiet-mute-conversation = İleti dizisini sessize al
quiet-unmute-conversation = İleti dizisinin sesini aç
quiet-mute-sender = Göndereni sessize al
quiet-unmute-sender = Gönderenin sesini aç
quiet-row-muted = Sessizde
