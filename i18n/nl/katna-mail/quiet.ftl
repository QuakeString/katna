## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Meldingen dempen
quiet-tip-off = Gedempt. Klik om weer te melden
quiet-tip-muted-until = Gedempt tot { $when }. Klik om weer te melden

## The right-click menu of a folder or an account

quiet-mute = Dempen…
quiet-unmute = Dempen opheffen
quiet-notify = Melden bij nieuwe e-mail

## How long to mute

quiet-for-hour = 1 uur
quiet-until-tomorrow = Tot morgenochtend
quiet-until-unmuted = Tot ik het weer aanzet
quiet-turn-on = Melden bij nieuwe e-mail

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } gedempt
quiet-muted-until = { $name } gedempt tot { $when }
quiet-on = { $name } meldt weer

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Gesprek dempen
quiet-unmute-conversation = Dempen van gesprek opheffen
quiet-mute-sender = Afzender dempen
quiet-unmute-sender = Dempen van afzender opheffen
quiet-row-muted = Gedempt
quiet-conversation-strip = Gedempt. Nieuwe antwoorden geven geen melding en tellen niet mee.
quiet-conversation-muted = { $count ->
    [one] Gesprek gedempt
   *[other] { $count } gesprekken gedempt
}
quiet-conversation-unmuted = { $count ->
    [one] Dempen van gesprek opgeheven
   *[other] Dempen van { $count } gesprekken opgeheven
}
quiet-sender-strip = Gedempt. Hun e-mail geeft geen melding en telt niet mee.
quiet-sender-muted = E-mail van { $address } gedempt
quiet-sender-unmuted = E-mail van { $address } meldt weer
