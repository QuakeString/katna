## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Senyapkan pemberitahuan
quiet-tip-off = Disenyapkan. Klik untuk memberitahu semula
quiet-tip-muted-until = Disenyapkan hingga { $when }. Klik untuk memberitahu semula

## The right-click menu of a folder or an account

quiet-mute = Senyapkan…
quiet-unmute = Nyahsenyap
quiet-notify = Beritahu tentang mel baharu

## How long to mute

quiet-for-hour = Selama 1 jam
quiet-until-tomorrow = Hingga pagi esok
quiet-until-unmuted = Hingga saya menghidupkannya semula
quiet-turn-on = Beritahu tentang mel baharu

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } disenyapkan
quiet-muted-until = { $name } disenyapkan hingga { $when }
quiet-on = { $name } memberitahu semula

