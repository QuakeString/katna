# Katna Mail, Swedish (Svenska).
# Machine-drafted by AI; not yet reviewed by a native speaker.
# Corrections welcome: see i18n/README.md.

## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Stäng av aviseringar
quiet-tip-off = Ljudlös. Klicka för att avisera igen
quiet-tip-muted-until = Ljudlös till { $when }. Klicka för att avisera igen

## The right-click menu of a folder or an account

quiet-mute = Stäng av ljud…
quiet-unmute = Slå på ljud
quiet-notify = Avisera om ny e-post

## How long to mute

quiet-for-hour = I 1 timme
quiet-until-tomorrow = Till i morgon bitti
quiet-until-unmuted = Tills jag slår på det igen
quiet-turn-on = Avisera om ny e-post

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } är ljudlös
quiet-muted-until = { $name } är ljudlös till { $when }
quiet-on = { $name } aviserar igen

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Gör konversationen ljudlös
quiet-unmute-conversation = Slå på ljud för konversationen
quiet-mute-sender = Gör avsändaren ljudlös
quiet-unmute-sender = Slå på ljud för avsändaren
quiet-row-muted = Ljudlös
quiet-conversation-strip = Ljudlös. Nya svar aviserar inte och räknas inte.
quiet-conversation-muted = { $count ->
    [one] Konversationen är ljudlös
   *[other] { $count } konversationer är ljudlösa
}
quiet-conversation-unmuted = { $count ->
    [one] Ljudet har slagits på för konversationen
   *[other] Ljudet har slagits på för { $count } konversationer
}
quiet-sender-strip = Ljudlös. Deras e-post aviserar inte och räknas inte.
quiet-sender-muted = E-post från { $address } är ljudlös
quiet-sender-unmuted = E-post från { $address } aviserar igen
