rules-editor-needs-days = “ഇത്രയും കഴിഞ്ഞ് വായിച്ചതായി അടയാളപ്പെടുത്തുക” എന്നതിന് 1 മുതൽ 3650 വരെ ദിവസങ്ങളുടെ എണ്ണം വേണം.
rules-saved = നിയമം സേവ് ചെയ്‌തു
rules-saved-applied = { $count ->
    [one] നിയമം സേവ് ചെയ്‌ത് { $count } മെയിലിന് ബാധകമാക്കി
   *[other] നിയമം സേവ് ചെയ്‌ത് { $count } മെയിലുകൾക്ക് ബാധകമാക്കി
}
rules-apply-failed = നിയമം സേവ് ചെയ്‌തു, പക്ഷേ ബാധകമാക്കാനായില്ല: { $error }
