## The bell on the list's toolbar, for the open folder or inbox tab

quiet-tip-rings = Silenciar notificaciones
quiet-tip-off = Silenciado. Haz clic para volver a notificar
quiet-tip-muted-until = Silenciado hasta { $when }. Haz clic para volver a notificar

## The right-click menu of a folder or an account

quiet-mute = Silenciar…
quiet-unmute = Reactivar sonido
quiet-notify = Notificar el correo nuevo

## How long to mute

quiet-for-hour = Durante 1 hora
quiet-until-tomorrow = Hasta mañana por la mañana
quiet-until-unmuted = Hasta que lo vuelva a activar
quiet-turn-on = Notificar el correo nuevo

## The note after a change, with Undo; { $name } is a folder, tab or account

quiet-off = { $name } silenciado
quiet-muted-until = { $name } silenciado hasta { $when }
quiet-on = { $name } vuelve a notificar

## Conversations and senders (the reading pane's bell, the More menus and
## the right-click menu)

quiet-mute-conversation = Silenciar la conversación
quiet-unmute-conversation = Dejar de silenciar la conversación
quiet-mute-sender = Silenciar al remitente
quiet-unmute-sender = Dejar de silenciar al remitente
quiet-row-muted = Silenciada
quiet-conversation-strip = Silenciada. Las respuestas nuevas no notificarán ni se contarán.
quiet-conversation-muted = { $count ->
    [one] Conversación silenciada
    [many] { $count } de conversaciones silenciadas
   *[other] { $count } conversaciones silenciadas
}
quiet-conversation-unmuted = { $count ->
    [one] Conversación ya no silenciada
    [many] { $count } de conversaciones ya no silenciadas
   *[other] { $count } conversaciones ya no silenciadas
}
quiet-sender-strip = Silenciado. Su correo no notificará ni se contará.
quiet-sender-muted = Correo de { $address } silenciado
quiet-sender-unmuted = El correo de { $address } vuelve a notificar
