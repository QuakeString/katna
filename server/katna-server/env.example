# Copy to .env next to compose.yaml and fill in.

# The tracking domain. Its DNS A (and AAAA) record points at this machine.
KATNA_TRACKING_DOMAIN=server.katna.invenia.in

# Any long random string, for example from `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The mail account that sends Katna account codes: the SMTP settings your
# mail provider gives (for Zoho Mail on your own domain: smtppro.zoho.in,
# port 465). Use an app password if the account has 2-step sign-in.
# Without a host the codes only go to `docker compose logs server`.
KATNA_SERVER_SMTP_HOST=
KATNA_SERVER_SMTP_PORT=465
KATNA_SERVER_SMTP_USERNAME=
KATNA_SERVER_SMTP_PASSWORD=
# Who the codes come from; empty means the username above. It must be that
# mailbox or one of its aliases.
KATNA_SERVER_MAIL_FROM=

# Optional.
# KATNA_SERVER_RETENTION_DAYS=180
# KATNA_SERVER_DAILY_LIMIT=5000
# KATNA_SERVER_IMAGE=ghcr.io/quakestring/katna-server:latest
# Translation (LibreTranslate): the languages to load, by code, and its
# CPU threads. Fewer languages need less memory.
# KATNA_TRANSLATE_LANGUAGES=en,hi,bn,ur,ar,fa,he,zh,zt,ja,ko,id,ms,th,vi,tl,tr,ru,uk,de,fr,es,pt,it,nl,pl,sv,sw
# KATNA_TRANSLATE_THREADS=4
# KATNA_SERVER_TRANSLATIONS_PER_DAY=2000
