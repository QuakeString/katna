# Copy to .env next to compose.yaml and fill in.

# The tracking domain. Its DNS A (and AAAA) record points at this machine.
KATNA_TRACKING_DOMAIN=server.katna.invenia.in

# Any long random string, for example from `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The mail account that sends Katna account codes: the SMTP settings your
# mail provider gives (for Zoho Mail on your own domain: smtppro.zoho.in,
# port 465). Use an app password if the account has 2-step sign-in.
# Without a host the server does not start (see KATNA_SERVER_DEV_MAILER).
KATNA_SERVER_SMTP_HOST=
KATNA_SERVER_SMTP_PORT=465
KATNA_SERVER_SMTP_USERNAME=
KATNA_SERVER_SMTP_PASSWORD=
# Who the codes come from; empty means the username above. It must be that
# mailbox or one of its aliases.
KATNA_SERVER_MAIL_FROM=

# Only to try the server alone, without an SMTP host: write the codes to
# `docker compose logs server` instead. Never where others sign up: anyone
# who can read that log could reset any account.
# KATNA_SERVER_DEV_MAILER=log

# Katna AI (writing help in Compose for Katna accounts). Without a key it
# is off. The key comes from the AI service's own site (for Gemini:
# aistudio.google.com, "Get API key"); it stays in this file only.
KATNA_SERVER_AI_KEY=
# The service: gemini (the default), openai, anthropic, mistral, deepseek,
# openrouter, or other (an OpenAI-like API at KATNA_SERVER_AI_BASE).
# KATNA_SERVER_AI_PROVIDER=gemini
# The model; empty is the service's usual one (gemini-2.5-flash-lite).
# KATNA_SERVER_AI_MODEL=
# KATNA_SERVER_AI_BASE=
# A second service, asked when the first fails (same four settings).
# KATNA_SERVER_AI_FALLBACK_PROVIDER=mistral
# KATNA_SERVER_AI_FALLBACK_KEY=
# KATNA_SERVER_AI_FALLBACK_MODEL=
# Days free from an account's first use, then it has to pay.
# KATNA_SERVER_AI_TRIAL_DAYS=30
# Most one account may cost a month, and all accounts together, in US
# dollars (a budget of 0 turns Katna AI off).
# KATNA_SERVER_AI_ACCOUNT_CAP_USD=1.00
# KATNA_SERVER_AI_BUDGET_USD=50
# The model's price per million tokens read and written, for those caps.
# KATNA_SERVER_AI_PRICE_IN_USD=0.10
# KATNA_SERVER_AI_PRICE_OUT_USD=0.40
# Requests per account per hour.
# KATNA_SERVER_AI_PER_HOUR=300
# The admin page (https://<tracking domain>/admin) chooses the service,
# model and limits above among the services with a key here, one per
# service. Its choices are saved and win over the lines above.
# KATNA_SERVER_AI_GEMINI_KEY=
# KATNA_SERVER_AI_MISTRAL_KEY=
# KATNA_SERVER_AI_OPENAI_KEY=
# KATNA_SERVER_AI_ANTHROPIC_KEY=
# KATNA_SERVER_AI_DEEPSEEK_KEY=
# KATNA_SERVER_AI_OPENROUTER_KEY=
# An OpenAI-like service of your own (key optional):
# KATNA_SERVER_AI_OTHER_BASE=
# KATNA_SERVER_AI_OTHER_KEY=

# Who runs this server: addresses that may open the admin page, split by
# commas. They are not Katna accounts. Set each one's password on the
# server with:
#   docker compose exec -it server katna-server admin-password [address]
# Signing in takes that password and a code mailed to the address (so the
# SMTP settings above must work). Empty: no page.
KATNA_SERVER_ADMIN_EMAILS=

# Optional.
# Hosts (and their subdomains) that tracked links may not go to, for
# abuse: split by commas. Links to them are refused and no longer followed.
# KATNA_SERVER_BLOCKED_HOSTS=phish.example,bad.example
# KATNA_SERVER_RETENTION_DAYS=180
# KATNA_SERVER_DAILY_LIMIT=5000
# KATNA_SERVER_IMAGE=ghcr.io/quakestring/katna-server:latest
# Translation (LibreTranslate): the languages to load, by code, and its
# CPU threads. Fewer languages need less memory.
# KATNA_TRANSLATE_LANGUAGES=en,hi,bn,ur,ar,fa,he,zh,zt,ja,ko,id,ms,th,vi,tl,tr,ru,uk,de,fr,es,pt,it,nl,pl,sv,sw
# KATNA_TRANSLATE_THREADS=4
# KATNA_SERVER_TRANSLATIONS_PER_DAY=2000
# Translation requests passed to LibreTranslate at once (more get 503).
# KATNA_SERVER_TRANSLATE_CONCURRENCY=8
# The LibreTranslate release (an image tag).
# KATNA_TRANSLATE_VERSION=v1.9.6
